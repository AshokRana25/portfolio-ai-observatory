# demo: deterministic local answers. live: a real LangChain model call.
APP_MODE=demo
# Required only for live mode. Choose a chat model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Traces include questions, retrieved synthetic records and generated answers.
# Enable deliberately; use only approved data with your chosen Langfuse host.
ENABLE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
